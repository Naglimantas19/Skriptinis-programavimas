Papildoma (a)
A = 5;
f = 5;
sigma = 1.5;
U1 = 3;
U2 = 2;

t = 0:0.001:1;
s = A*sin(2*pi*f*t);
n = sigma*randn(size(t));
x = s + n;
filtruotas = x;
filtruotas(abs(filtruotas) < U2) = 0;
figure

subplot(1,2,1)

plot(t, x, '-', 'LineWidth', 1.25)
hold on

plot(t, filtruotas, '--', 'LineWidth', 1.25)

yline(U1, 'r', 'LineWidth', 1.25)
yline(U2, 'r', 'LineWidth', 1.25)

xlabel('Laikas, s')
ylabel('Itampa, V')

title('Pradinis ir filtruotas signalai', ...
    'Color', 'b', 'FontSize', 14)

legend('Pradinis signalas', 'Filtruotas signalas', 'U1', 'U2')

grid on

Papildoma (b)
subplot(1,2,2)
ind = x > U1;
t2 = t(ind);
x2 = x(ind);
stem(t2, x2)
hold on
min_reiksme = min(x2);
max_reiksme = max(x2);
min_ind = x2 == min_reiksme;
max_ind = x2 == max_reiksme;
plot(t2(min_ind), x2(min_ind), 'o')
plot(t2(max_ind), x2(max_ind), 'go', 'MarkerSize', 8)
xlabel('Laikas, s')
ylabel('Itampa, V')
title('Signalo reiksmes virs U1', ...
    'Color', 'b', 'FontSize', 14)

legend('Signalas virs U1', 'Minimumas', 'Maksimumas')

grid on
