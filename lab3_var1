1a. 1c.
t = linspace(-pi, pi, 50);
y = sin(t);
figure 
plot(t, y, 'r--')

xlabel('t')
ylabel('y')
title('y(t) = sin(t)')
axis([min(t) max(t) min(y) max(y)])
legend('sin(t)', 'Location','south')
grid on

1b. 1c,
x = linspace(-pi, pi, 50);
y1 = -x.^2 + 9;
y2 = x.^3 - 2*x.^2 - 9;
figure
plot(x, y1, x, y2)

xlabel('x')
ylabel('y')
title('Dvi funkcijos')
axis([min(x) max(x) min([y1 y2]) max([y1 y2])])
legend('-x^2+9', 'x^3-2x^2-9', 'Location', 'south')
grid on


