1a.
theta = 0:0.1:2*pi;
r = 0:0.05:1;

[theta,r] = meshgrid(theta,r);

x = r.*cos(theta);
y = r.*sin(theta);

z = 1 - 2*x.^2 - 3*y.^2;

figure
surf(x,y,z)

shading interp
colormap parula

xlabel('x')
ylabel('y')
zlabel('f(x,y)')
title('f(x,y) = 1 - 2x^2 - 3y^2')

view(45,45)
grid on

1b.
x = -2:0.1:2;
y = -2:0.1:2;

[x,y] = meshgrid(x,y);

z = sin(abs(x+y)/20).*exp(-abs(x+y));

figure
surf(x,y,z)

shading interp
colormap parula

xlabel('x')
ylabel('y')
zlabel('f(x,y)')
title('f(x,y) = sin(|x+y|/20) * e^{-|x+y|}')

view(60,60)
grid on

