function varargout = sin_cos_papildom_LD6(varargin)

if nargin == 1
    x = varargin{1};
else
    error('Reikia vieno ivesties argumento')
end

s = sin(x);
c = cos(x);

if nargout == 0
    figure
    plot(x, s, 'r', x, c, 'b')
    xlabel('x')
    ylabel('Reiksme')
    title('Sin ir Cos funkcijos')
    legend('sin(x)', 'cos(x)')
    grid on
else
    varargout{1} = s;
    if nargout > 1
        varargout{2} = c;
    end
end

end
